{
  "name": "cpp-practice-website",
  "version": "2.0.0",
  "description": "CPPractice Lab — a premium C++ practice platform with 2,040 problems, an in-browser IDE and a real local g++/clang++ compiler backend.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node tests/api.test.js",
    "test:e2e": "node tests/e2e.browser.js",
    "test:all": "node tests/api.test.js && node tests/e2e.browser.js",
    "generate:data": "node scripts/generate-problems-json.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cpp",
    "compiler",
    "judge",
    "practice",
    "express",
    "local-execution"
  ],
  "license": "MIT"
}
