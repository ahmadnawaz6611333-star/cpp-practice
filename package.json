{
  "name": "cpppractice",
  "version": "2.0.0",
  "description": "A premium C++ practice platform with 2,040 curated problems, an in-browser IDE and a real C++ (g++) compiler that runs locally or in the cloud.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node tests/api.test.js",
    "test:e2e": "node tests/e2e.browser.js",
    "test:cloud": "node tests/cloud.test.js",
    "test:deploy": "node tests/deploy.browser.js",
    "test:adsense": "node tests/adsense.test.js",
    "test:all": "node tests/api.test.js && node tests/cloud.test.js && node tests/e2e.browser.js && node tests/adsense.test.js",
    "generate:data": "node scripts/generate-problems-json.js",
    "og:image": "node scripts/gen-og-image.js",
    "brand:sync": "node scripts/sync-brand.js",
    "brand:check": "node scripts/sync-brand.js --check",
    "sitemap": "node scripts/gen-sitemap.js",
    "check:adsense": "node scripts/check-adsense.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cpp",
    "compiler",
    "judge",
    "judge0",
    "practice",
    "express",
    "local-execution",
    "cloud-execution"
  ],
  "license": "MIT"
}
